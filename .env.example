# Server-side PostgreSQL connection. Copy this file to `.env` and replace PASSWORD.
# Never use a REACT_APP_ prefix: that would expose the value in the browser bundle.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/quotation_calculator

# Optional for local/self-signed PostgreSQL setups. Prefer proper certificates in production.
DATABASE_SSL=false

# Admin API. Set a strong, unique password before running the seed command.
API_PORT=3001
API_HOST=0.0.0.0
HOST=0.0.0.0
# Comma-separated frontend origins allowed to call the API.
APP_ORIGIN=http://localhost:3000,http://192.168.68.79:3000
ADMIN_SEED_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
NODE_ENV=development
